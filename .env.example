# Local environment variables for LinkLab
# Copy this file to .env for local docker-compose or CLI development.

POSTGRES_USER=linklab
POSTGRES_PASSWORD=CHANGEME_LOCAL_PASSWORD
POSTGRES_DB=linklab
DATABASE_URL=postgres://linklab:CHANGEME_LOCAL_PASSWORD@localhost:5432/linklab?sslmode=disable
REDIS_URL=redis://localhost:6379

# AWS / LocalStack configuration
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
